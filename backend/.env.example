# Munay Map Backend — Variables de entorno
# Copiar a .env para desarrollo local

# Puerto del servidor (default: 3000)
PORT=3000

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Modo mock: true = usa mocks locales sin llamadas a Google Cloud
# Cambiar a false cuando las credenciales de Google Cloud estén configuradas
GOOGLE_CLOUD_MOCK_MODE=false

# ID del proyecto en Google Cloud Console (https://console.cloud.google.com)
GOOGLE_CLOUD_PROJECT_ID=

# Ruta al archivo JSON de credenciales de la cuenta de servicio de Google Cloud
# Puede ser ruta absoluta (recomendado) o relativa al directorio backend/
# Descargar desde: https://console.cloud.google.com → IAM → Cuentas de servicio → Claves
GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/al/archivo-credenciales.json

# API key de Gemini — Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# API key para recomendaciones externas (opcional — misma key que Gemini o una dedicada)
# Obtener en: https://aistudio.google.com/app/apikey
RECOMMENDATIONS_API_KEY=
