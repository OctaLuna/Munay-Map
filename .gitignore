# ============================================================
# Munay Map — .gitignore
# Cubre: Frontend (Vite + React + TS) + Backend (NestJS + Node)
# ============================================================

# ─── Dependencias ───────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ─── Builds de producción ───────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/

# ─── Variables de entorno ───────────────────────────────────
# NUNCA commitear archivos con secrets reales
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Sí se commitea el ejemplo (sin valores reales)
!.env.example

# ─── TypeScript ─────────────────────────────────────────────
*.tsbuildinfo
*.d.ts.map

# ─── Caché de herramientas ──────────────────────────────────
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.prettiercache

# Vite
.vite/
vite.config.ts.timestamp-*

# TailwindCSS
.tailwindcss/

# ─── Testing ────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Vitest
vitest.config.ts.timestamp-*

# ─── Logs ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Sistema operativo ──────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ─── Editores e IDEs ────────────────────────────────────────
# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains (IntelliJ, WebStorm, etc.)
.idea/
*.iml
*.ipr
*.iws

# Vim / Neovim
*.swp
*.swo
*~
Session.vim
.netrwhist

# Emacs
*#
.#*
\#*#

# ─── NestJS / Backend ───────────────────────────────────────
# Directorio de build de NestJS
backend/dist/
backend/build/

# Uploads temporales
backend/uploads/
backend/tmp/

# ─── Base de datos ──────────────────────────────────────────
# SQLite (si se usa en desarrollo)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal

# Flyway (migraciones ejecutadas localmente)
.flyway/

# ─── Docker ─────────────────────────────────────────────────
# No ignorar Dockerfile ni docker-compose.yml (se commitean)
# Sí ignorar datos persistidos localmente
docker-data/
postgres-data/
redis-data/

# ─── Google Cloud / GCP ─────────────────────────────────────
# Credenciales de service account — NUNCA commitear
*-service-account.json
*-credentials.json
gcloud-key.json
service-account-key.json
application_default_credentials.json

# ─── Certificados y claves ──────────────────────────────────
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# ─── PWA ────────────────────────────────────────────────────
# Generados por vite-plugin-pwa (se regeneran en build)
frontend/dist/sw.js
frontend/dist/workbox-*.js
frontend/dist/manifest.webmanifest

# ─── Misc ───────────────────────────────────────────────────
# Archivos temporales
*.tmp
*.temp
*.bak
*.orig

# Archivos grandes / binarios
*.zip
*.tar.gz
*.rar
*.7z

# Storybook
storybook-static/

# Sentry
.sentryclirc


# O específicamente el nombre del archivo:
docs/munay-map-8421e94db8b8.json